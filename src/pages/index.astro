---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				margin-bottom: 2.5rem;
			}
			.hero p {
				color: rgb(var(--gray));
				font-size: 1.1em;
				max-width: 36em;
			}
			.latest {
				margin: 0 0 1rem;
				font-size: 1.4em;
			}
			ul {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			li {
				margin-bottom: 1.75rem;
				padding-bottom: 1.75rem;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			li:last-child {
				border-bottom: none;
			}
			li a {
				display: grid;
				gap: 0.35rem;
				text-decoration: none;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				font-size: 1.35em;
				line-height: 1.3;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.description {
				margin: 0.25rem 0 0;
				color: rgb(var(--gray-dark));
				font-size: 0.95em;
			}
			li a:hover .title {
				color: var(--accent);
			}
			.more {
				display: inline-block;
				margin-top: 0.5rem;
			}
			.thumb {
				margin-top: 0.75rem;
				border-radius: 10px;
				overflow: hidden;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>{SITE_TITLE}</h1>
				<p>{SITE_DESCRIPTION}</p>
			</section>
			<section>
				<h2 class="latest">最新文章</h2>
				<ul>
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<h3 class="title">{post.data.title}</h3>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
								<p class="description">{post.data.description}</p>
								{post.data.heroImage && (
									<div class="thumb">
										<Image width={720} height={240} src={post.data.heroImage} alt="" />
									</div>
								)}
							</a>
						</li>
					))}
				</ul>
				<a class="more" href="/blog">查看全部文章 →</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
